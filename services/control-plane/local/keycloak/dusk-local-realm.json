        {"name":"dusk workload","protocol":"openid-connect","protocolMapper":"oidc-usermodel-attribute-mapper","consentRequired":false,"config":{"user.attribute":"dusk_workload_id","claim.name":"dusk_workload_id","jsonType.label":"String","id.token.claim":"true","access.token.claim":"true"}},
        {"name":"control plane audience","protocol":"openid-connect","protocolMapper":"oidc-audience-mapper","consentRequired":false,"config":{"included.custom.audience":"dusk-control-plane","id.token.claim":"false","access.token.claim":"true"}}
      ]
    }
  ],
