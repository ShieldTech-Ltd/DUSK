# Copy to .env and fill in values only when overriding the local defaults.
# Never commit .env.

# Optional external SIE service. Leave blank for the deterministic default.
# Set SIE_API_KEY only when the selected endpoint requires it.
DUSK_SIE_ENDPOINT=
SIE_API_KEY=
DUSK_SIE_ENCODE_MODEL=BAAI/bge-m3
DUSK_SIE_SCORE_MODEL=BAAI/bge-reranker-v2-m3
DUSK_SIE_EXTRACT_MODEL=urchade/gliner_multi-v2.1

# Optional local bearer authentication. Generate and inject a unique value at
# runtime for any non-demo deployment. Do not commit a real value here.
DUSK_GATE_API_KEY=

# Browser CORS is disabled by default. Use exact trusted origins only.
DUSK_CORS_ALLOWED_ORIGINS=
