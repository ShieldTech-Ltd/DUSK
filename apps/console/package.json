{
  "name": "@dusk/security-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "configure": "node scripts/deployment-config.mjs",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run && node --test scripts/deployment-config.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "generate:api": "openapi-typescript ../../services/control-plane/contracts/openapi.json -o src/api/schema.d.ts",
    "check:api": "npm run generate:api && git diff --exit-code -- src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.87.4",
    "@tanstack/react-router": "1.131.35",
    "echarts": "6.1.0",
    "lucide-react": "0.544.0",
    "oidc-client-ts": "3.3.0",
    "openapi-fetch": "0.14.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
