{
  "name": "DUSK Alert to SOAR",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dusk-alert",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b1a4c2e0-1f3a-4d7b-9c11-0a1b2c3d4e5f",
      "name": "DUSK Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 320],
      "webhookId": "dusk-alert"
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "agent_id",
              "value": "={{ $json.body.analysis.agent_id }}",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "verdict",
              "value": "={{ $json.body.verdict }}",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "score",
              "value": "={{ $json.body.analysis.score }}",
              "type": "number"
            },
            {
              "id": "f4",
              "name": "mitre_attack",
              "value": "={{ $json.body.analysis.mitre_attack }}",
              "type": "string"
            },
            {
              "id": "f5",
              "name": "blast_radius",
              "value": "={{ $json.body.analysis.blast_radius }}",
              "type": "string"
            },
            {
              "id": "f6",
              "name": "summary",
              "value": "=DUSK {{ $json.body.verdict }} for agent {{ $json.body.analysis.agent_id }}: {{ $json.body.analysis.mitre_attack }} (blast radius {{ $json.body.analysis.blast_radius }}, score {{ $json.body.analysis.score }})",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c2b5d3f1-2a4b-4e8c-8d22-1b2c3d4e5f60",
      "name": "Format Alert",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://soar.internal.example/api/incidents",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "d3c6e4a2-3b5c-4f9d-9e33-2c3d4e5f6071",
      "name": "Open SOAR Incident",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 320]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"received\": true, \"agent_id\": $json.agent_id, \"verdict\": $json.verdict } }}",
        "options": {}
      },
      "id": "e4d7f5b3-4c6d-4a0e-8f44-3d4e5f607182",
      "name": "Acknowledge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [960, 320]
    }
  ],
  "connections": {
    "DUSK Webhook": {
      "main": [
        [
          {
            "node": "Format Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Alert": {
      "main": [
        [
          {
            "node": "Open SOAR Incident",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Open SOAR Incident": {
      "main": [
        [
          {
            "node": "Acknowledge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": [
    {
      "name": "dusk"
    },
    {
      "name": "soar"
    }
  ]
}
