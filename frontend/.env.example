# Trace Frontend — Environment Variables Example
# Copy to .env.local for local development. NEVER commit .env.local.
# Real secrets must NOT be committed to version control.

# ── Backend API URL ───────────────────────────────────────────────────────────
# When set, the frontend calls the real backend. When empty, demo/mock mode is used.
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000

# ── Attio CRM ─────────────────────────────────────────────────────────────────
# Used for customer records, security opportunities, and audit trail
# These must only be used server-side (Next.js API routes), never in client code.
ATTIO_API_KEY=
ATTIO_WORKSPACE_ID=

# ── Tavily (web intelligence for customer discovery) ──────────────────────────
TAVILY_API_KEY=

# ── Superlinked (semantic vector matching) ────────────────────────────────────
SUPERLINKED_API_KEY=
SUPERLINKED_ENDPOINT=

# ── n8n (workflow automation) ─────────────────────────────────────────────────
N8N_WEBHOOK_URL=

# ── Mubit Minima (cost-aware model routing) ───────────────────────────────────
MUBIT_API_KEY=

# ── Google Gemini (risk explanation & plan generation) ────────────────────────
GEMINI_API_KEY=

# ── Aikido (security scan report URL) ────────────────────────────────────────
AIKIDO_REPORT_URL=
