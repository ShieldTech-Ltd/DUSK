# Trace Frontend — Environment Variables
# Copy to .env.local for local development. NEVER commit .env.local.
#
# When NEXT_PUBLIC_BACKEND_API_URL is empty (the default), the frontend
# calls the Next.js API routes on the same server (/api/...).
# All integrations fall back to demo mode when their API key is missing.

# ── Mode ──────────────────────────────────────────────────────────────────────
# demo = always use demo data (even if keys are present)
# live = use real integrations when keys are present
TRACE_MODE=demo

# ── Backend URL ───────────────────────────────────────────────────────────────
# Leave empty to use the local Next.js API routes (recommended for development and demo).
#
# IMPORTANT: The Python DUSK backend (src/dusk/) is a CLI library with no HTTP server.
# Do NOT set this to point at the Python backend — it will break all API calls.
#
# Only set this if a teammate has deployed a separate HTTP API (e.g. FastAPI wrapper
# around ActionGate and AlertResponder) that serves the /api/security/... routes.
# Example: NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_API_URL=

# ── Attio CRM ─────────────────────────────────────────────────────────────────
# System of record for customers, security opportunities, and deployment records.
# MUST be set server-side only — never exposed to the browser.
ATTIO_API_KEY=
ATTIO_WORKSPACE_ID=

# ── Tavily (web intelligence) ─────────────────────────────────────────────────
# Used for customer discovery and threat enrichment.
TAVILY_API_KEY=

# ── Superlinked (semantic vector matching) ────────────────────────────────────
# Used for ICP scoring and incident similarity search.
SUPERLINKED_API_KEY=
SUPERLINKED_ENDPOINT=

# ── n8n (workflow automation) ─────────────────────────────────────────────────
# Used for SOAR escalation, approval workflows and customer follow-up.
# Set to your n8n webhook URL, e.g. https://your-n8n.example.com
N8N_WEBHOOK_URL=

# ── Mubit Minima (cost-aware model routing) ───────────────────────────────────
# Used to recommend the cheapest model for each security analysis task.
MUBIT_API_KEY=

# ── Google Gemini (risk explanation & plan generation) ────────────────────────
# Used to generate manager-facing risk explanations and fix summaries.
GEMINI_API_KEY=

# ── Aikido (security scan evidence) ───────────────────────────────────────────
# URL of the Aikido security report for the build.
AIKIDO_REPORT_URL=
