# Copy to .env and fill in your values. Never commit .env.

# Attio CRM -- create incidents on WOULD-BLOCK / BLOCK verdicts
# Get your key at app.attio.com/settings/api
ATTIO_API_KEY=

# n8n -- webhook fired on every alert (SOAR / notification workflows)
N8N_WEBHOOK_URL=

# Tavily -- live web fetch in the demo (optional)
# Used by: TAVILY_API_KEY=<key> python demo/live_attack.py --url <url>
TAVILY_API_KEY=

# Flask API server (defaults shown)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
