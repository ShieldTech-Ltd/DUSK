# Copy to .env and fill in your values. Never commit .env

# ── SIE -- behavioural similarity for the agent action gate ──────
# Used by: src/dusk/trace/vector.py (encode/score/extract primitives),
# via the process-wide Config (src/dusk/config.py) -- these are also
# settable in dusk.yaml (sie_endpoint, sie_encode_model, ...).
# Self-hosted: the defaults below need no key.
# Superlinked-hosted tester access: set the endpoint and key instead.
DUSK_SIE_ENDPOINT=http://sie:8080
SIE_API_KEY=
DUSK_SIE_ENCODE_MODEL=BAAI/bge-m3
DUSK_SIE_SCORE_MODEL=BAAI/bge-reranker-v2-m3
DUSK_SIE_EXTRACT_MODEL=urchade/gliner_multi-v2.1

# ── Aikido -- runtime security scanning ─────────────────────────
# Used by: Aikido Zen runtime firewall
# Get at: aikido.dev
AIKIDO_TOKEN=
