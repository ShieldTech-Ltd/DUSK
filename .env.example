# Copy to .env and fill in your values. Never commit .env

# ── Tavily -- live threat intel enrichment ──────────────────────
# Used by: demo/live_attack.py and src/dusk/integrations/tavily_enrichment.py
# Get key at: tavily.com
TAVILY_API_KEY=

# ── Gemini -- AI reasoning layer ────────────────────────────────
# Used by: Gemini Flash for plain-language threat explanation
# Get key at: ai.google.dev
GEMINI_API_KEY=

# ── Mubit -- persistent agent decision memory ───────────────────
# Used by: src/dusk/trace/recorder.py
# Get key at: console.mubit.ai
MUBIT_API_KEY=

# ── Superlinked (legacy) -- vector similarity for the company-
# ── research demo, unrelated to the agent action gate ───────────
# Used by: src/dusk/analyser.py
SUPERLINKED_API_KEY=
SUPERLINKED_ENDPOINT=

# ── SIE -- behavioural similarity for the agent action gate ──────
# Used by: src/dusk/trace/vector.py (encode/score/extract primitives),
# via the process-wide Config (src/dusk/config.py) -- these are also
# settable in dusk.yaml (sie_endpoint, sie_encode_model, ...).
# Self-hosted (docker compose): the defaults below need no key.
# Superlinked-hosted tester access: set the endpoint and key instead.
DUSK_SIE_ENDPOINT=http://sie:8080
SIE_API_KEY=
DUSK_SIE_ENCODE_MODEL=BAAI/bge-m3
DUSK_SIE_SCORE_MODEL=BAAI/bge-reranker-v2-m3
DUSK_SIE_EXTRACT_MODEL=urchade/gliner_multi-v2.1

# ── Attio -- CRM incident tracking ──────────────────────────────
# Used by: src/dusk/integrations/attio_client.py
# Get key at: app.attio.com/settings/api
ATTIO_API_KEY=

# ── n8n -- gate webhooks ─────────────────────────────────────────
# Used by: src/dusk/trace/n8n_client.py, via Config, fired by
# src/dusk/api.py's /v1/gate on every verdict (decision, report) and
# on refusals (alert). Also settable in dusk.yaml.
# Get webhook URLs from your own n8n instance.
DUSK_N8N_ALERT_URL=
DUSK_N8N_REPORT_URL=
DUSK_N8N_DECISION_URL=

# ── n8n -- legacy single webhook ─────────────────────────────────
# Used by: src/dusk/recorder.py, the older company-research demo flow,
# unrelated to the agent action gate above.
N8N_WEBHOOK_URL=

# ── Aikido -- runtime security scanning ─────────────────────────
# Used by: Aikido Zen runtime firewall
# Get at: aikido.dev
AIKIDO_TOKEN=

# ── Flask API server ────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_ENV=development

# ── TRACE audit trail ───────────────────────────────────────────
TRACE_DECISIONS_PATH=trace-decisions.json

# ── Gate service -- /v1/gate HTTP endpoint ───────────────────────
# Used by: src/dusk/api.py
# Baseline is loaded once at startup and never mutated by live traffic.
# Leave DUSK_GATE_BASELINE_PATH unset to run with no baseline (every
# agent is treated as unknown). See docs/action-schema.md for the
# expected JSON shape.
DUSK_GATE_BASELINE_PATH=
DUSK_GATE_BASELINE_SOURCE=generic
DUSK_ENFORCE=false
