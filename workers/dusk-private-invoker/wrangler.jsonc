{
  "name": "dusk-private-proof-invoker",
  "main": "src/index.js",
  "compatibility_date": "2026-09-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "secrets": { "required": ["DUSK_INVOKER_TOKEN"] },
  "services": [
    {
      "binding": "DUSK_GATEWAY",
      "service": "dusk-scope-sandbox",
      "remote": true
    },
    {
      "binding": "DUSK_TARGET",
      "service": "dusk-owned-sandbox-target",
      "remote": true
    }
  ]
}
